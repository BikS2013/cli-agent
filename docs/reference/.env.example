# cli-agent — environment variables reference
# Copy the variables you need, uncomment them, and fill in real values.
# NEVER commit secrets to version control.
#
# Precedence (Policy A — shell-wins):
#   1. Shell env vars (exported in your shell profile)  — HIGHEST
#   2. ~/.tool-agents/cli-agent/.env                   — per-user persistent
#   3. ./.env in current working directory              — project-local
#   4. CLI flags (--provider, --model, etc.)            — HIGHEST for flags
#
# Recommendation: export OPENAI_API_KEY etc. in your ~/.zshrc / ~/.bash_profile
# for secrets you use across many tools. Use ~/.tool-agents/cli-agent/.env for
# cli-agent–specific overrides that persist across sessions.

# ---------------------------------------------------------------------------
# Provider selection (non-secret — safe to put in shell profile)
# ---------------------------------------------------------------------------

# AGENT_PROVIDER=azure-openai      # one of: openai|anthropic|gemini|azure-openai|azure-anthropic|ollama|litellm|mlx
# AGENT_MODEL=                     # model id or deployment name
# AGENT_ALLOW_MUTATIONS=false      # true|false — enable mutating tools

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                  # optional proxy URL
# OPENAI_ORG_ID=                    # optional org ID

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=               # optional proxy URL

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------

# GOOGLE_API_KEY=AIza...            # canonical name
# GEMINI_API_KEY=AIza...            # accepted alias (GOOGLE_API_KEY takes precedence)

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

# AZURE_OPENAI_API_KEY=             # from Azure portal → Keys and Endpoint
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=          # deployment name (e.g. gpt-4o)
# AZURE_OPENAI_API_VERSION=2024-02-01

# ---------------------------------------------------------------------------
# Azure Anthropic (Foundry)
# ---------------------------------------------------------------------------

# AZURE_AI_INFERENCE_KEY=           # canonical name; from Foundry resource
# AZURE_AI_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com
# ANTHROPIC_FOUNDRY_API_KEY=        # alias (canonical takes precedence)
# ANTHROPIC_FOUNDRY_ENDPOINT=       # alias (canonical takes precedence)

# ---------------------------------------------------------------------------
# Ollama (local)
# ---------------------------------------------------------------------------

# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# LiteLLM proxy (local)
# ---------------------------------------------------------------------------

# LITELLM_PROXY_URL=http://localhost:4000   # canonical name
# LITELLM_MASTER_KEY=                       # canonical name
# LITELLM_API_BASE=                         # alias for LITELLM_PROXY_URL
# LITELLM_API_KEY=                          # alias for LITELLM_MASTER_KEY

# ---------------------------------------------------------------------------
# MLX-LM (local — reuses OPENAI_BASE_URL)
# ---------------------------------------------------------------------------

# OPENAI_BASE_URL=http://localhost:8080/v1  # point at MLX-LM server

# ---------------------------------------------------------------------------
# Web search backend
# ---------------------------------------------------------------------------

# WEB_SEARCH_BACKEND=tavily         # tavily|serpapi|brave|duckduckgo|custom-http
# TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=
# BRAVE_API_KEY=
# WEB_SEARCH_URL=                   # required only if backend=custom-http
# WEB_SEARCH_API_KEY=               # optional for custom-http
# WEB_SEARCH_MAX_REQUESTS=50        # per-session hard cap (default 50)

# ---------------------------------------------------------------------------
# Bash tool
# ---------------------------------------------------------------------------

# BASH_ALLOWED_COMMANDS=git,gh,kubectl   # csv of binary names

# ---------------------------------------------------------------------------
# File tool
# ---------------------------------------------------------------------------

# FILE_EDIT_ROOT=                   # override working root for file_* tools

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# CLI_AGENT_LOG=                    # set to off|0|false|no to disable JSONL logging
